{
  "name": "mini-stock",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:cloudflare": "nuxt build --preset=cloudflare_pages",
    "db:migrate:local": "npx wrangler d1 migrations apply mini-stock --local",
    "db:migrate:remote": "npx wrangler d1 migrations apply mini-stock --remote",
    "db:seed:local": "npx wrangler d1 execute mini-stock --local --file=seed.sql",
    "db:seed:remote": "npx wrangler d1 execute mini-stock --remote --file=seed.sql",
    "dev:cloudflare": "npm run build:cloudflare && npx wrangler pages dev dist",
    "deploy": "npm run build:cloudflare && npx wrangler pages deploy dist",
    "preview": "nuxt preview",
    "lint": "eslint --ext .js,.ts,.vue .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "nuxt": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nuxt/test-utils": "^4.3.2",
    "@tailwindcss/vite": "^4.1.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.3",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.1"
  }
}
